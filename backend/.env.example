# Copy this file to ".env" and fill in the real values.

# Postgres connection string for your Supabase project (Project Settings ->
# Database -> Connection string -> URI, in the Supabase dashboard). Required -
# the backend stores everything here (accounts, contacts, campaigns,
# LinkedIn-log) and won't start without it. See README.md, "Database
# (Supabase)".
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Path to the service-account JSON key file downloaded from Google Cloud.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# The Workspace mailbox the backend sends/reads mail as.
SEND_AS_EMAIL=sales@twikeycampaigns.nl

# Comma-separated list of origins allowed to call this API from a browser.
# For local testing with the HTML file opened directly, "*" is fine.
CORS_ORIGINS=*

# Shared secret required (as an X-Admin-Secret header) to create new
# customer accounts via POST /api/admin/accounts. Pick any long random
# string for local testing - it just needs to match what you pass to curl.
ADMIN_SECRET=change-me-to-something-random

# Encrypts customer SMTP passwords at rest (see POST /api/email-settings /
# backend/crypto.py). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# On Render this is auto-generated for you (see render.yaml) - you only need
# to set this by hand for local development. Never commit the real value or
# change it once accounts have saved SMTP settings (their saved password can
# then no longer be decrypted - they'd have to re-enter it).
ENCRYPTION_KEY=

# Optional. Used to generate AI concept-replies to incoming customer replies
# (see POST /api/replies/fetch, backend/ai_client.py). This is a single
# shared, platform-level key - not per customer account - since it's a small
# number of generations per incoming reply, not a metered per-search cost
# like Explorium. Without it, concept-replies fall back to the matched
# objection category's standard suggested reply (or a generic fallback text)
# instead of an AI-generated draft. See README.md, "Reply-tracking,
# AI-conceptantwoorden en opvolgsequenties".
ANTHROPIC_API_KEY=

# Optional, defaults to claude-sonnet-4-5-20250929 if unset. Overrides which
# Claude model is used to draft concept-replies.
ANTHROPIC_DRAFT_MODEL=
