# Copy this file to ".env" and fill in the real values.

# Path to the service-account JSON key file downloaded from Google Cloud.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# The Workspace mailbox the backend sends/reads mail as.
SEND_AS_EMAIL=sales@twikeycampaigns.nl

# Comma-separated list of origins allowed to call this API from a browser.
# For local testing with the HTML file opened directly, "*" is fine.
CORS_ORIGINS=*

# Shared secret required (as an X-Admin-Secret header) to create new
# customer accounts via POST /api/admin/accounts. Pick any long random
# string for local testing - it just needs to match what you pass to curl.
ADMIN_SECRET=change-me-to-something-random
