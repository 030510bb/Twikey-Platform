{
  "manifest_version": 3,
  "name": "Twikey Sales - LinkedIn Outreach Log",
  "version": "1.1.0",
  "description": "Vult je eigen LinkedIn-berichten in vanuit je templates (kopieer naar klembord) en logt outreach naar je Twikey Sales Platform dashboard. Verstuurt of klikt NIETS automatisch op LinkedIn - jij doet dat zelf, dit bespaart alleen tikwerk en logt het resultaat.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://twikey-platform-backend.onrender.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
